<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Notes</RootNamespace>
    <Version>0.6.0</Version>
    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT' and Exists('D:/Steam')">D:/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT'">$(MSBuildProgramFiles32)/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == ''">$(HOME)/.local/share/Steam</SteamRoot>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(SteamRoot)/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2LocalDataDir Condition="'$(OS)' == 'Windows_NT'">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2LocalDataDir>
    <Sts2LocalDataDir Condition="'$(OS)' != 'Windows_NT'">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2LocalDataDir>
    <Sts2MinRefsDir Condition="'$(Sts2MinRefsDir)' == ''">$(MSBuildProjectDirectory)/.refs/sts2-refs/0.107.1</Sts2MinRefsDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(Sts2UseLocalGame)' != 'true' and Exists('$(Sts2MinRefsDir)/sts2.dll')">$(Sts2MinRefsDir)</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2LocalDataDir)</Sts2DataDir>
    <RitsuWorkshopRoot Condition="'$(RitsuWorkshopRoot)' == ''">$(SteamRoot)/steamapps/workshop/content/2868840/3747602295</RitsuWorkshopRoot>
    <RitsuLibReferenceTarget Condition="'$(RitsuLibReferenceTarget)' == ''">0.107.1</RitsuLibReferenceTarget>
    <RitsuLibReferencesProps>$(RitsuWorkshopRoot)/RitsuLib.References.props</RitsuLibReferencesProps>
    <ModOutputDir>$(Sts2Dir)/mods/Notes</ModOutputDir>
    <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">false</CopyModOnBuild>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <Import Project="$(RitsuLibReferencesProps)" Condition="Exists('$(RitsuLibReferencesProps)')" />

  <ItemGroup>
    <Compile Remove="src/Notes.Core/bin/**/*.cs" />
    <Compile Remove="src/Notes.Core/obj/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src/Runtime/Localization/*.json">
      <LogicalName>Notes.Localization.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="找不到 $(Sts2DataDir)/sts2.dll。请检查 SteamRoot 或 -p:Sts2DataDir。" />
    <Error Condition="!Exists('$(RitsuLibReferencesProps)')" Text="找不到 $(RitsuLibReferencesProps)。请检查 SteamRoot 或 RitsuWorkshopRoot。" />
  </Target>

  <Target Name="CopyMod" AfterTargets="Build" Condition="'$(CopyModOnBuild)' == 'true'">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Notes.json" DestinationFolder="$(ModOutputDir)" />
  </Target>
</Project>
